# Punarva Environment Configuration Example
# Replace the placeholder values with your real credentials in .env

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/punarva
PORT=8000
HOST=0.0.0.0
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db
TIMEOUT_HOURS=48
